APP_NAME="MAKU Union"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=hi

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maku_union
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="MAKU Admin"
ADMIN_EMAIL=admin@maku.local
ADMIN_PASSWORD=change-this-password

MAKU_UPLOAD_DISK=public
MAKU_UPLOAD_MAX_KB=4096
MAKU_MEMBERSHIP_FEE=100
MAKU_RENEWAL_FEE=100
MAKU_PAYMENT_GATEWAY=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_MONTHLY_LIMIT=500
